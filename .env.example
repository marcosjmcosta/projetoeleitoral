# Agente Eleitoral Unificado 2026 — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# URL pública do seu servidor (preenchida automaticamente pelo Render)
PLUGIN_BASE_URL=https://SEU-SERVIDOR.onrender.com

# Chave de acesso ao @Agentes Eleitoral
AGENTES_ELEITORAL_TOKEN=
AGENTES_ELEITORAL_CLIENT_ID=gemini-eleitoral

# Chave de acesso ao SEU plugin (crie uma senha forte)
PLUGIN_API_KEY=

# Token de verificação fornecido pela OpenAI ao registrar o plugin
OPENAI_VERIFICATION_TOKEN=

# Seu e-mail de contato
CONTACT_EMAIL=seu@email.com
